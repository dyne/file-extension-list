# Exit immediately on each error and unset variable;
# see: https://vaneyckt.io/posts/safer_bash_scripts_with_set_euxo_pipefail/
#set -Eeuo pipefail
set -eu

script_dir=$(dirname "$(readlink -f "$0")")
proj_dir="$(cd "$script_dir"/..; pwd)"
build_dir="$proj_dir/build"
tmp_dir="$build_dir/tmp"
data_dir="$proj_dir/data"

exit_code=0

mkdir -p "$build_dir"
mkdir -p "$tmp_dir"

cd "$data_dir/categories"

data_files_listing="$tmp_dir/categories_files_listing.tsv"
find . -name '*.csv' | sed -e 's|^\./||' > "$data_files_listing"

while read -r csv
do
    line_index=1
    while read -r line
    do
        if ! printf "%s" "$line" | grep --quiet '^[^,]\+,%\?$'
        then
            >&2 echo "Invalid line format at $csv:$line_index: '$line'"
            exit_code=$((exit_code + 2))
        fi
        line_index=$((line_index + 1))
    done < "$csv"
done < "$data_files_listing"

line_index=1
csv="$data_dir/extensions.csv"
while read -r line
do
    if ! printf "%s" "$line" | grep --quiet '^[^,]\+,[-op],[-bt]$'
    then
        >&2 echo "Invalid line format at $csv:$line_index: '$line'"
        exit_code=$((exit_code + 4))
    fi
    line_index=$((line_index + 1))
done < "$csv"

rm -Rf "$tmp_dir"

exit $exit_code
