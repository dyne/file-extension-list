#!/usr/bin/env sh

# SPDX-FileCopyrightText: 2026 Robin Vobruba <hoijui.quaero@gmail.com>
#
# SPDX-License-Identifier: Unlicense

# Exit immediately on each error and unset variable;
# see: https://vaneyckt.io/posts/safer_bash_scripts_with_set_euxo_pipefail/
#set -Eeuo pipefail
set -eu

script_dir=$(dirname "$(readlink -f "$0")")
proj_dir="$(cd "$script_dir"/..; pwd)"
build_dir="$proj_dir/build"
tmp_dir="$build_dir/tmp"
data_dir="$proj_dir/data"

exit_code=0

mkdir -p "$build_dir"
mkdir -p "$tmp_dir"

cd "$data_dir/categories"

data_files_listing="$tmp_dir/categories_files_listing.tsv"
find . -name '*.csv' | sed -e 's|^\./||' > "$data_files_listing"

all_sorted="$tmp_dir/all_sorted.txt"
while read -r csv
do
    cat "$csv"
done < "$data_files_listing" \
    | sort \
    > "$all_sorted"

duplicates="$tmp_dir/duplicates.txt"
uniq --repeated "$all_sorted" > "$duplicates"

echo
echo "Checking for duplicate primaries ..."
duplicate_primaries="$tmp_dir/duplicate_primaries.txt"
grep -v '%$' "$duplicates" > "$duplicate_primaries" || true
if [ "$(cat "$duplicate_primaries" | wc -l)" -gt 0 ]
then
    {
    echo "Multiple definitions of a file extensions primary category"
    echo "(without the duplication marker '%'):"
    cat "$duplicate_primaries"
    } >&2
    exit_code=$((exit_code + 2))
fi
echo "Checking for duplicate primaries - done."

non_primaries="$tmp_dir/non_primaries.txt"
grep '%$' "$all_sorted" > "$non_primaries" || true
num_non_primaries="$(cat "$non_primaries" | wc -l)"
echo
echo "Checking $num_non_primaries non-primaries for missing primaries ..."
missing_primaries=0
while read -r non_prim
do
    # echo "DEBUG: Checking '$non_prim' for missing primary ..."
    primary="$(printf "%s" "$non_prim" | sed -e 's/%$//')"
    if ! grep --quiet -r "^$primary\$" "$all_sorted"
    then
        if [ $missing_primaries -eq 0 ]
        then
            >&2 echo "Missing primary category for extensions:"
        fi
        >&2 echo "$non_prim"
        missing_primaries=$((missing_primaries + 1))
    fi
done < "$non_primaries"
if [ $missing_primaries -gt 0 ]
then
    exit_code=$((exit_code + 4))
fi
echo "Checking $num_non_primaries non-primaries for missing primaries - done."

rm -Rf "$tmp_dir"

exit $exit_code
